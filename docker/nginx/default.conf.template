# ==================== NGINX: FRONTEND + PROXY AL BACKEND ====================
# ${PORT} lo sustituye el entrypoint oficial de nginx (envsubst).
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # Health check de Render: solo responde 200 cuando Spring Boot y la BD están listos
    location = /healthz {
        access_log off;
        proxy_pass http://127.0.0.1:8080/actuator/health;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    # Assets generados por Vite (nombre con hash): cache agresivo
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # API -> Spring Boot dentro del mismo contenedor (sin CORS)
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # SPA: cualquier ruta que no sea un archivo real va a index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
